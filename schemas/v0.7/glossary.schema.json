{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mip.dev/schemas/0.7/glossary.schema.json",
  "title": "MIP Glossary Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "revision",
    "term",
    "domain",
    "definition",
    "aliases",
    "interpretations",
    "provenance",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "term": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "interpretations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "context",
          "meaning",
          "motionHints"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "context": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "motionHints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "enum": [
            "standard",
            "project",
            "human"
          ]
        },
        "reference": {
          "type": "string"
        }
      }
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "deprecated"
      ]
    }
  }
}
