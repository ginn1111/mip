{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mip.dev/schemas/0.7/evidence-pack.schema.json",
  "title": "MIP Reference Evidence Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "id",
    "sources",
    "observations",
    "hypotheses",
    "bindings"
  ],
  "properties": {
    "protocol": {
      "const": "mip/0.7"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "uri",
          "digest",
          "capturedAt",
          "environment",
          "licenseOrPermissionNotes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "video",
              "gif",
              "website",
              "figma",
              "storyboard"
            ]
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "$ref": "#/$defs/digest"
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time"
          },
          "environment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "viewport",
              "device",
              "frameRate"
            ],
            "properties": {
              "viewport": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "device": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "frameRate": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "licenseOrPermissionNotes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourceId",
          "timeRangeMs",
          "actorId",
          "event",
          "property",
          "measuredValue",
          "measurementMethod",
          "confidence",
          "evidenceRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "timeRangeMs": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "actorId": {
            "type": "string",
            "minLength": 1
          },
          "event": {
            "type": "string",
            "minLength": 1
          },
          "property": {
            "type": "string",
            "minLength": 1
          },
          "measuredValue": {},
          "measurementMethod": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "concept",
          "proposedInterpretation",
          "sourceObservationIds",
          "confidence",
          "alternatives",
          "reviewStatus"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "concept": {
            "type": "string",
            "minLength": 1
          },
          "proposedInterpretation": {
            "type": "string",
            "minLength": 1
          },
          "sourceObservationIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reviewStatus": {
            "enum": [
              "proposed",
              "accepted",
              "rejected"
            ]
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "intentField",
          "observationIds",
          "hypothesisIds",
          "provenanceClass"
        ],
        "properties": {
          "intentField": {
            "type": "string",
            "minLength": 1
          },
          "observationIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "hypothesisIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "provenanceClass": {
            "enum": [
              "OBSERVED",
              "INFERRED",
              "DECLARED"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "evidence": {
      "type": "object",
      "required": [
        "uri",
        "digest",
        "mediaType"
      ],
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
